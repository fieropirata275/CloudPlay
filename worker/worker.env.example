# Nodo gaming. Lo normal es que lo rellene el instalador:
#   curl -fsSL https://play.example.com/install/node.sh | sudo bash -s -- --join-token TOKEN

# URL pública del orquestador (wss)
CP_URL=wss://play.example.com
# Alta automática: con el token de unión del orquestador (cloudplay join-token) el nodo se da de alta solo
# y guarda su token propio en DATA_DIR/node.token. NODE_TOKEN solo si lo creaste a mano en el panel.
JOIN_TOKEN=
NODE_TOKEN=
# Nombre en el panel (por defecto, el hostname)
NODE_NAME=

# Sesiones simultáneas en este nodo y plataformas que acepta
CAPACITY=4
PLATFORMS=ps2,gc,wii

# nvidia | vaapi | cpu
GPU=nvidia
NVIDIA_GPUS=0
# Para GPU=vaapi (Intel/AMD), uno o varios render nodes:
DRI_NODES=/dev/dri/renderD128

SESSION_IMAGE=cloudplay/session:local
# Rutas del HOST
LIBRARY_DIR=/srv/cloudplay/library
BIOS_DIR=/srv/cloudplay/bios
DATA_DIR=/var/lib/cloudplay

# Puertos UDP de WebRTC: slot i usa ICE_PORT_BASE + i*20 ... +19 (no hace falta abrirlos con el TURN de Cloudflare)
ICE_PORT_BASE=40000
ICE_PORTS_PER_SLOT=20

RESOLUTION=1280x720
SESSION_CPUS=4
SESSION_MEM=6g
IDLE_TIMEOUT=180
MAX_PADS=2
# Copia de las partidas en curso cada N segundos (por si se va la luz). 0 = desactivado
AUTOSAVE_INTERVAL=300
# Variables extra para el contenedor de sesión (JSON), p.ej. {"UPSCALE":"3","BITRATE_KBPS":"12000"}
SESSION_EXTRA_ENV={}

# S3 de partidas guardadas. Vacío = el que entrega el orquestador al dar de alta el nodo
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=cloudplay-saves
