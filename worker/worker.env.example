# URL pública del control plane (wss)
CP_URL=wss://play.example.com
# Token que da: docker compose exec api python -m app.cli create-node --name gpu-01 --capacity 4
NODE_TOKEN=

# Sesiones simultáneas en este nodo y plataformas que acepta
CAPACITY=4
PLATFORMS=ps2,gc,wii

# nvidia | vaapi | cpu
GPU=nvidia
NVIDIA_GPUS=0
# Para GPU=vaapi (Intel/AMD), uno o varios render nodes:
DRI_NODES=/dev/dri/renderD128

SESSION_IMAGE=cloudplay/session:latest
# Rutas del HOST
LIBRARY_DIR=/srv/cloudplay/library
BIOS_DIR=/srv/cloudplay/bios
DATA_DIR=/var/lib/cloudplay

# Puertos UDP de WebRTC: slot i usa ICE_PORT_BASE + i*20 ... +19 (abre ese rango en el firewall)
ICE_PORT_BASE=40000
ICE_PORTS_PER_SLOT=20

RESOLUTION=1280x720
SESSION_CPUS=4
SESSION_MEM=6g
IDLE_TIMEOUT=180
MAX_PADS=2
# Variables extra para el contenedor de sesión (JSON), p.ej. {"UPSCALE":"3","BITRATE_KBPS":"12000"}
SESSION_EXTRA_ENV={}

# MinIO del control plane (partidas guardadas)
S3_ENDPOINT=http://10.10.0.1:9000
S3_ACCESS_KEY=cloudplay
S3_SECRET_KEY=
S3_BUCKET=cloudplay-saves
