# ---------- Control plane ----------
CP_DOMAIN=play.example.com
# Web comercial (landing estática en landing/out)
LANDING_DOMAIN=www.example.com
PUBLIC_IP=203.0.113.10

# Genera con: openssl rand -base64 48
CP_JWT_SECRET=CAMBIA_ESTO
TURN_SECRET=CAMBIA_ESTO_TAMBIEN
POSTGRES_PASSWORD=CAMBIA_ESTO_3

CP_ADMIN_EMAIL=admin@example.com
CP_ADMIN_PASSWORD=CAMBIA_ESTO_4
CP_ALLOW_REGISTRATION=false
# Orígenes permitidos (las apps de TV usan file:// o app://; la landing llama a /api/leads desde su dominio)
CP_CORS_ORIGINS=*

# ---------- MinIO (partidas guardadas) ----------
S3_ACCESS_KEY=cloudplay
S3_SECRET_KEY=CAMBIA_ESTO_5
# IP en la que escucha MinIO (pon la IP de la LAN/VPN que ven los workers)
S3_BIND=127.0.0.1
