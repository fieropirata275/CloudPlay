# Configuración del orquestador. El instalador (deploy/install/install.sh) genera este fichero con
# secretos aleatorios; si lo haces a mano, cambia TODOS los CAMBIA_ESTO.

# ---------- Dominios ----------
CP_DOMAIN=play.example.com
# Web comercial (landing estática en landing/out)
LANDING_DOMAIN=www.example.com
# Con Cloudflare Tunnel: CP_SITE=http://play.example.com y LANDING_SITE=http://www.example.com
# (Cloudflare pone el TLS). Sin túnel déjalos vacíos: Caddy pide certificados a Let's Encrypt.
CP_SITE=
LANDING_SITE=
PUBLIC_IP=203.0.113.10

# ---------- Perfiles opcionales ----------
# coturn: TURN propio (abre UDP 3478 y 49160-49400) · tunnel: Cloudflare Tunnel (sin abrir puertos)
COMPOSE_PROFILES=coturn

# ---------- Secretos (openssl rand -base64 48) ----------
CP_JWT_SECRET=CAMBIA_ESTO
TURN_SECRET=CAMBIA_ESTO_TAMBIEN
POSTGRES_PASSWORD=CAMBIA_ESTO_3
# Token de unión: con él los nodos gaming se dan de alta solos (plantillas, ISO, Kubernetes)
CP_JOIN_TOKEN=CAMBIA_ESTO_6

CP_ADMIN_EMAIL=admin@example.com
CP_ADMIN_PASSWORD=CAMBIA_ESTO_4
CP_ALLOW_REGISTRATION=false
# Orígenes permitidos (las apps de TV usan file:// o app://; la landing llama a /api/leads desde su dominio)
CP_CORS_ORIGINS=*

# ---------- TURN (vídeo cuando no hay conexión directa) ----------
# coturn | cloudflare | none. Con Cloudflare Tunnel usa "cloudflare": el vídeo pasa por el TURN de Cloudflare
# y no necesitas ningún puerto UDP abierto. Crea la clave en el panel de Cloudflare → Realtime → TURN.
CP_TURN_PROVIDER=coturn
CP_CF_TURN_KEY_ID=
CP_CF_TURN_API_TOKEN=

# ---------- Cloudflare Tunnel ----------
TUNNEL_TOKEN=

# ---------- Almacenamiento S3 de partidas guardadas (SeaweedFS) ----------
S3_ACCESS_KEY=cloudplay
S3_SECRET_KEY=CAMBIA_ESTO_5
# IP en la que escucha el S3 (pon la IP de la LAN/VPN que ven los nodos, o publícalo como s3.<dominio> en el túnel)
S3_BIND=127.0.0.1

# Imágenes: "cloudplay/" + "local" = compiladas aquí; "ghcr.io/USUARIO/cloudplay-" + "v1.0.0" = las de GHCR
CLOUDPLAY_IMAGES=cloudplay/
CLOUDPLAY_TAG=local
